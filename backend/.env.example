# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file - it's already in .gitignore.

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# Database (AWS RDS PostgreSQL)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=thaidelight_admin
DB_PASSWORD=CHANGE_ME_use_a_strong_password
DB_NAME=thaidelight
DB_SSL=true

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret

# AWS S3 (image uploads)
AWS_REGION=us-east-1
S3_BUCKET_NAME=thai-delight-menu-images

# AWS credentials should NOT be set here in production if the app runs on EC2.
# Instead, attach an IAM Role to the EC2 instance with S3 write permissions.
# Only use these for local development testing:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
